{
  "expo": {
    "name": "ASATA Connect",
    "slug": "asata-connect",
    "scheme": "asata-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2B55"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ma.asata.connect"
    },
    "android": {
      "package": "ma.asata.connect",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D2B55"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "11316e8b-cb7b-46a0-9bcf-88b37aa34650"
      }
    }
  }
}
